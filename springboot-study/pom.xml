<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 独立学习项目：不继承外层练习项目的依赖，避免旧日志依赖与 Spring Boot 冲突。 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.example.learning</groupId>
    <artifactId>springboot-study</artifactId>
    <version>1.0.0</version>
    <name>springboot-study</name>
    <description>通过账户转账学习接口、事务、全局异常处理和 AOP</description>

    <properties>
        <java.version>21</java.version>
        <!-- 4.1.x Starter 适配 Spring Boot 4.1，避免使用面向 Boot 3 的 3.x Starter。 -->
        <mybatis-spring-boot.version>4.1.0</mybatis-spring-boot.version>
        <!-- springdoc 3.2.0 使用 Spring Boot 4.1.2，可直接提供 Swagger UI 页面。 -->
        <springdoc-openapi.version>3.2.0</springdoc-openapi.version>
    </properties>

    <!-- Spring Boot 统一管理下面的版本，不单独指定 Spring Framework 等依赖版本。 -->
    <dependencies>
        <!-- Spring MVC：接收 HTTP 请求，将 Java 对象序列化为 JSON。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- 根据 Controller 自动生成 OpenAPI 文档，并提供浏览器中的接口操作页面。 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc-openapi.version}</version>
        </dependency>
        <!-- Actuator：提供健康检查、应用信息和运行指标等监控端点。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- 参数校验：提供 @Valid、@NotNull、@Positive 等注解。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- JDBC、连接池和事务管理器均由 Spring Boot 自动配置。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- Flyway 按版本执行数据库迁移，MySQL 支持通过专用模块提供。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <!-- MyBatis：创建 Mapper 代理、加载 XML，并参与 Spring 的数据源和事务管理。 -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>${mybatis-spring-boot.version}</version>
        </dependency>
        <!-- 只在运行时需要 MySQL JDBC 驱动，版本交给 Spring Boot 管理。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Boot 4 使用 aspectj starter，运行时仍是 Spring AOP 的代理模式。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 支持 spring-boot:run，并将应用打包为可执行 jar。 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
