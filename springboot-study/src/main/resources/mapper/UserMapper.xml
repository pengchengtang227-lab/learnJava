<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.springstudy.mapper.UserMapper">

    <!-- 显式映射数据库列到 JavaBean 属性，解决 user_name 与 userName 等命名差异。 -->
    <resultMap id="userResultMap" type="com.example.springstudy.model.UserDO">
        <id column="id" property="id"/>
        <result column="user_name" property="userName"/>
        <result column="age" property="age"/>
        <result column="email" property="email"/>
        <result column="gender" property="gender"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
    </resultMap>

    <!-- 查询列显式列举；sql + include 用于复用相同的字段清单。 -->
    <sql id="userColumns">
        id, user_name, age, email, gender, gmt_create, gmt_modified
    </sql>

    <select id="listUsers" resultMap="userResultMap">
        SELECT <include refid="userColumns"/>
        FROM study_user
        ORDER BY id
    </select>

    <!-- #{} 生成 JDBC 占位符并绑定值，用户输入不会作为 SQL 文本拼接。 -->
    <select id="getUserById" resultMap="userResultMap">
        SELECT <include refid="userColumns"/>
        FROM study_user
        WHERE id = #{id}
    </select>

    <!-- JDBC 取回自增主键，MyBatis 调用 UserDO.setId 将值回填。 -->
    <insert id="insertUser" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO study_user (user_name, age, email, gender)
        VALUES (#{userName}, #{age}, #{email}, #{gender})
    </insert>

    <!-- PUT 更新完整的可编辑字段；WHERE id 只影响目标用户，不修改创建时间。 -->
    <update id="updateUser">
        UPDATE study_user
        SET user_name = #{userName},
            age = #{age},
            email = #{email},
            gender = #{gender},
            gmt_modified = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <!-- 本例演示物理删除。缺少 ID 的请求会先在 Controller 被校验拦截。 -->
    <delete id="deleteUser">
        DELETE FROM study_user WHERE id = #{id}
    </delete>
</mapper>
