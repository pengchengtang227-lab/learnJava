<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.springstudy.mapper.UserMapper">

    <!-- 显式映射数据库列到 JavaBean 属性，解决 user_name 与 userName 等命名差异。
     如果property 没匹配就会出错-->
    <resultMap id="userResultMap" type="com.example.springstudy.model.UserDO">
        <id column="id" property="id"/>
        <result column="user_name" property="userName"/>
        <result column="age" property="age"/>
        <result column="email" property="email"/>
        <result column="gender" property="gender"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
    </resultMap>

    <!-- 查询列显式列举；sql + include 用于复用相同的字段清单。 -->
    <sql id="userColumns">
        id, user_name, age, email, gender, gmt_create, gmt_modified
    </sql>

    <select id="listUsers" resultMap="userResultMap">
        SELECT <include refid="userColumns"/>
        FROM study_user
        ORDER BY id
    </select>

    <!-- #{} 生成 JDBC 占位符并绑定值，用户输入不会作为 SQL 文本拼接。
    as 之后 如果名字和Java对象属性没对应上，不会报错 -->
    <select id="getUserById" resultType="com.example.springstudy.model.UserDO">
        SELECT id,
        user_name as userName,
        age,
        email,
        gender,
        gmt_create as gmtCreate,
        gmt_modified as gmtModified
        FROM study_user
        WHERE id = #{id}
    </select>

    <!-- JDBC 取回自增主键，MyBatis 调用 UserDO.setId 将值回填。 -->
    <insert id="insertUser" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO study_user (user_name, age, email, gender)
        VALUES (#{userName}, #{age}, #{email}, #{gender})
    </insert>

    <!-- PUT 更新完整的可编辑字段；WHERE id 只影响目标用户，不修改创建时间。 -->
    <update id="updateUser">
        UPDATE study_user
        SET user_name = #{userName},
            age = #{age},
            email = #{email},
            gender = #{gender},
            gmt_modified = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <!-- 本例演示物理删除。缺少 ID 的请求会先在 Controller 被校验拦截。 -->
    <delete id="deleteUser">
        DELETE FROM study_user WHERE id = #{id}
    </delete>

    <!--
        例子 1：GET /api/users/dynamic-sql/search
        bind 用 OGNL 创建 namePattern，例如 ali 变成 ali%；仍由 #{} 绑定，不拼入 SQL。
        choose 只选一个分支：有精确用户名时用 when，否则由 otherwise 尝试前缀查询。
        if 按需追加前缀、年龄条件；where 有内容才生成 WHERE，并去掉开头的 AND/OR。
        参数全部为空时不生成 WHERE；同时传姓名、前缀时只使用精确姓名。
    -->
    <select id="searchUsers" resultMap="userResultMap">
        <bind name="namePattern" value="namePrefix == null ? null : namePrefix + '%'"/>
        SELECT <include refid="userColumns"/>
        FROM study_user
        <where>
            <choose>
                <when test="userName != null and userName != ''">
                    AND user_name = #{userName}
                </when>
                <otherwise>
                    <if test="namePrefix != null and namePrefix != ''">
                        AND user_name LIKE #{namePattern}
                    </if>
                </otherwise>
            </choose>
            <if test="age != null">
                AND age = #{age}
            </if>
        </where>
        ORDER BY id
    </select>

    <!--
        例子 2：GET /api/users/dynamic-sql/by-ids?ids=1,2,3
        trim 自定义 WHERE 前缀，并删除开头多余的 AND/OR，作用类似上面的 where。
        foreach 的 collection 是参数名，item 是当前元素名；open/close 加括号，separator 加逗号。
        null/空列表走 otherwise，生成 WHERE 1 = 0，直接调用 Mapper 也不会查出全部用户。
    -->
    <select id="listUsersByIds" resultMap="userResultMap">
        SELECT <include refid="userColumns"/>
        FROM study_user
        <trim prefix="WHERE" prefixOverrides="AND |OR ">
            <choose>
                <when test="ids != null and !ids.isEmpty()">
                    AND id IN
                    <foreach collection="ids" item="id" open="(" separator="," close=")">
                        #{id}
                    </foreach>
                </when>
                <otherwise>
                    AND 1 = 0
                </otherwise>
            </choose>
        </trim>
        ORDER BY id
    </select>

    <!--
        例子 3：PATCH /api/users/dynamic-sql/{id}
        if 只加入非 null 的字段；null 表示不修改，数值 0 仍会正常参与更新。
        set 添加 SET 并删除末尾逗号；修改时间每次更新，创建时间始终保留。
        WHERE id 始终存在；Service 会拒绝所有字段均为空的请求，并在更新后查询完整数据。
    -->
    <update id="updateUserSelective">
        UPDATE study_user
        <set>
            <if test="userName != null">
                user_name = #{userName},
            </if>
            <if test="age != null">
                age = #{age},
            </if>
            <if test="email != null">
                email = #{email},
            </if>
            <if test="gender != null">
                gender = #{gender},
            </if>
            gmt_modified = CURRENT_TIMESTAMP,
        </set>
        WHERE id = #{id}
    </update>
</mapper>
